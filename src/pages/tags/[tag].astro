---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBlogPosts } from '../../lib/db/content';

export const prerender = false;

const { tag } = Astro.params;
const db = Astro.locals.runtime.env.DB;

// Load all published posts and filter by tag
const allPosts = await getBlogPosts(db, { status: 'published', limit: 100 });
const posts = allPosts
  .filter(post => Array.isArray(post.tags) && post.tags.includes(tag))
  .sort((a, b) => new Date(b.publishDate || 0).getTime() - new Date(a.publishDate || 0).getTime());
---

<BaseLayout pageTitle={`Posts tagged "${tag}"`}>
  <h2>Posts tagged "{tag}"</h2>
  {posts.length > 0 ? (
    <ul>
      {posts.map(post => (
        <li style="display: flex; align-items: center;">
          <a href={`/blog/${post.slug}`} style="display: flex; align-items: center;">
            {post.thumbnail && (
              <img
                src={post.thumbnail}
                alt={`${post.title} thumbnail`}
                style="width: 200px; margin-right: 10px;"
              />
            )}
            <div>
              <h3 style="margin: 0;">{post.title}</h3>
              <p style="margin: 0;">{post.publishDate ? new Date(post.publishDate).toLocaleDateString() : ''}</p>
              <p style="margin: 0;">{post.description}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p>No posts found for this tag.</p>
  )}
</BaseLayout>

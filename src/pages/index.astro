---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import TimelineFeed from '../components/TimelineFeed.svelte';

const title = 'Emily Cogsdill';
const description = 'One of the people of all time.';
const permalink = Astro.site.href;
---

<BaseLayout title={title} description={description} permalink={permalink}>
  <div class="timeline-page">
    <header class="timeline-header">
      <h1 class="timeline-title">Thoughts</h1>
      <p class="timeline-subtitle">Quick musings and observations</p>
    </header>

    <TimelineFeed client:load />

    <nav class="site-links">
      <h2 class="links-title">More from this site</h2>
      <ul class="links-list">
        <li>
          <a href="/blog">Blog</a>
          <span class="link-desc">Longer form writing</span>
        </li>
        <li>
          <a href="/museum">Museum</a>
          <span class="link-desc">Project showcase</span>
        </li>
        <li>
          <a href="/bio">Biography</a>
          <span class="link-desc">About me</span>
        </li>
        <li>
          <a href="/chat">Chat</a>
          <span class="link-desc">AI assistant</span>
        </li>
      </ul>
    </nav>
  </div>
</BaseLayout>

<style>
  .timeline-page {
    max-width: 700px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .timeline-header {
    text-align: center;
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .timeline-title {
    font-size: 2.5rem;
    margin: 0 0 0.5rem 0;
    color: var(--primary-color);
    font-family: var(--font-family-sans);
  }

  .timeline-subtitle {
    font-size: 1rem;
    color: var(--text-secondary);
    margin: 0;
    font-style: italic;
  }

  .site-links {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    max-width: 650px;
    margin-left: auto;
    margin-right: auto;
  }

  .links-title {
    font-size: 1.25rem;
    color: var(--text-secondary);
    margin: 0 0 1.5rem 0;
    font-weight: 500;
    text-align: center;
  }

  .links-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .links-list li {
    margin: 0;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .links-list li:hover {
    border-color: var(--primary-color);
    background: rgba(255, 255, 255, 0.05);
  }

  .links-list a {
    display: block;
    color: var(--primary-color);
    text-decoration: none;
    font-family: var(--font-family-sans);
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
    transition: color 0.2s ease;
  }

  .links-list a:hover {
    color: #fff;
  }

  .link-desc {
    display: block;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  @media (max-width: 480px) {
    .timeline-title {
      font-size: 2rem;
    }

    .links-list {
      grid-template-columns: 1fr;
    }
  }
</style>

---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import ThoughtsMasonry from '../components/ThoughtsMasonry.svelte';
import { getThoughts } from '../lib/db/content';

const title = 'Emily Cogsdill';
const description = 'One of the people of all time.';
const permalink = Astro.site.href;

// Get D1 database from runtime environment
const db = Astro.locals.runtime.env.DB;

// Fetch published thoughts from D1
const allThoughts = await getThoughts(db, { status: 'published', limit: 200 });

// Extract all unique tags
const allTags = [...new Set(allThoughts.flatMap(t => t.tags || []))].sort();

// Serialize thoughts for Svelte component
const thoughtsData = allThoughts.map(t => ({
  id: t.id,
  slug: t.slug,
  title: t.title,
  content: t.content,
  color: t.color,
  images: t.images,
  tags: t.tags,
  status: t.status,
  publishDate: t.publishDate,
  publishTime: t.publishTime,
}));
---

<BaseLayout title={title} description={description} permalink={permalink}>
  <div class="home-header">
    <h1 class="home-title">Thoughts</h1>
    <p class="home-subtitle">Quick thoughts and musings - my personal micro-blog.</p>
    <nav class="home-nav">
      <a href="/blog">Blog</a>
      <a href="/museum">Museum</a>
      <a href="/bio">Bio</a>
      <a href="/chat">Chat</a>
    </nav>
  </div>

  <ThoughtsMasonry
    client:load
    thoughts={thoughtsData}
    allTags={allTags}
  />
</BaseLayout>

<style>
  .home-header {
    text-align: center;
    margin-bottom: 2rem;
    padding: 2rem 1rem;
  }

  .home-title {
    font-size: 2.5rem;
    color: var(--primary-color);
    margin: 0 0 0.5rem 0;
    font-weight: 700;
    letter-spacing: -1px;
  }

  .home-subtitle {
    color: rgba(255, 255, 255, 0.5);
    font-style: italic;
    margin: 0 0 1.5rem 0;
    font-size: 1.1rem;
  }

  .home-nav {
    display: flex;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .home-nav a {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-size: 1rem;
    padding: 0.5rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    transition: all 0.2s ease;
  }

  .home-nav a:hover {
    color: #fff;
    border-color: var(--primary-color);
    background: rgba(255, 255, 255, 0.05);
  }

  @media (max-width: 600px) {
    .home-title {
      font-size: 2rem;
    }

    .home-nav {
      gap: 1rem;
    }

    .home-nav a {
      font-size: 0.9rem;
      padding: 0.4rem 0.8rem;
    }
  }
</style>

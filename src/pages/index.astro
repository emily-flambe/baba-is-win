---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import MagazineThoughts from '../components/MagazineThoughts.svelte';
import { processSimpleMarkdown } from '../utils/simpleMarkdown.js';
import { getThoughts } from '../lib/db/content';

const title = 'Emily Cogsdill';
const description = 'One of the people of all time.';
const permalink = Astro.site.href;

// Get D1 database from runtime environment
const db = Astro.locals.runtime.env.DB;

// Fetch published thoughts from D1
const allThoughts = await getThoughts(db, { status: 'published', limit: 100 });
---

<BaseLayout title={title} description={description} permalink={permalink}>
  <div class="magazine-page">
    <header class="page-header">
      <h1 class="page-title">Thoughts</h1>
      <p class="page-subtitle">Musings, observations, and the occasional coherent idea</p>
    </header>

    <MagazineThoughts
      client:load
      thoughts={allThoughts}
      processMarkdown={processSimpleMarkdown}
    />

    <nav class="site-nav">
      <h2 class="nav-title">Elsewhere on this site</h2>
      <ul class="nav-links">
        <li><a href="/blog">Blog</a> - Longer form writing</li>
        <li><a href="/museum">Museum</a> - Project showcase</li>
        <li><a href="/bio">Bio</a> - About me</li>
        <li><a href="/chat">Chat</a> - Talk to an AI trained on my content</li>
      </ul>
    </nav>
  </div>
</BaseLayout>

<style>
  .magazine-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 0;
  }

  .page-header {
    text-align: center;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .page-title {
    font-size: 3rem;
    margin: 0 0 0.5rem 0;
    letter-spacing: -1px;
  }

  .page-subtitle {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
    font-style: italic;
  }

  .site-nav {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .nav-title {
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.6);
    margin: 0 0 1rem 0;
    font-weight: 400;
  }

  .nav-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
  }

  .nav-links li {
    margin: 0;
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .nav-links a {
    color: var(--primary-color);
    text-decoration: none;
    font-weight: 500;
  }

  .nav-links a:hover {
    color: #fff;
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .magazine-page {
      padding: 1rem 0;
    }

    .page-header {
      margin-bottom: 2rem;
    }

    .page-title {
      font-size: 2.2rem;
    }

    .page-subtitle {
      font-size: 1rem;
    }

    .nav-links {
      flex-direction: column;
      gap: 1rem;
    }

    .site-nav {
      margin-top: 3rem;
    }
  }
</style>

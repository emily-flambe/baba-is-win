---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import ThoughtsGrid from '../components/ThoughtsGrid.svelte';
import { getThoughts } from '../lib/db/content';

const title = 'Emily Cogsdill';
const description = 'One of the people of all time.';
const permalink = Astro.site.href;

// Get D1 database from runtime environment
const db = Astro.locals.runtime.env.DB;

// Fetch published thoughts from D1
const allThoughts = await getThoughts(db, { status: 'published', limit: 200 });

// Map thoughts to the format expected by the Svelte component
const thoughtsData = allThoughts.map(thought => ({
  id: thought.id,
  slug: thought.slug,
  title: thought.title,
  content: thought.content,
  color: thought.color,
  images: thought.images.map(img => ({
    url: typeof img === 'string' ? img : img.url,
    offset: typeof img === 'string' ? '50%' : (img.offset ? `${img.offset.y}%` : '50%')
  })),
  tags: thought.tags,
  publishDate: thought.publishDate,
  publishTime: thought.publishTime,
}));
---

<BaseLayout title={title} description={description} permalink={permalink}>
  <div class="home-container">
    <header class="page-header">
      <h1>Thoughts</h1>
      <p class="subtitle">Quick thoughts and musings</p>
    </header>

    <ThoughtsGrid thoughts={thoughtsData} client:load />
  </div>
</BaseLayout>

<style>
  .home-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .page-header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
  }

  .page-header h1 {
    font-size: 2.5rem;
    margin: 0 0 0.5rem 0;
    color: var(--primary-color);
  }

  .subtitle {
    color: var(--text-secondary);
    font-style: italic;
    margin: 0;
    font-size: 1.1rem;
  }

  @media (max-width: 768px) {
    .page-header h1 {
      font-size: 2rem;
    }

    .subtitle {
      font-size: 1rem;
    }
  }
</style>
